                }
                break;


                case 3:
                    System.out.println("Enter withdraw amount: ");
                    double withdraw = imran.nextDouble();
                       balance -= withdraw;
                  if(withdraw > 0 && withdraw <= balance){
                   
                    System.out.println("Withdraw Successful");
                    System.out.println("Remining Balance:"+balance);
