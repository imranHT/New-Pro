<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <button id = "myButton">Roll</button><br><br>
    <label id="label1" class=" myLabels"></label><br>
    <label id="label2" class="myLabels"></label><br>
    <label id="label3" class="myLabels"></label><br>
    <label id="label4" class="myLabels"></label><br>
    <label id="label5" class="myLabels"></label><br>
    <label id="label6" class="myLabels"></label>

    <script src="index.js"></script>
</body>
